# What the overleaf Process receives (deploy-kit spec/v1, chapter 10, Configuration).
OVERLEAF_SITE_URL=${exposure:overleaf.public#url}
OVERLEAF_APP_NAME=jorisjonkers.dev LaTeX
OVERLEAF_ADMIN_EMAIL=joris.jonkers@jorisjonkers.dev
OVERLEAF_SESSION_SECRET=${secret:secret/data/platform/overleaf#session_secret}
OVERLEAF_INVITE_TOKEN_SECRET=${secret:secret/data/platform/overleaf#invite_token_secret}
OVERLEAF_SECURE_COOKIE=true
OVERLEAF_RESTRICT_INVITES_TO_EXISTING_ACCOUNTS=true
# The in-container nginx, and the edge in front of it.
OVERLEAF_TRUSTED_PROXY_IPS=loopback, 10.42.0.0/16

# The platform's Mongo, a literal until the data Project declares it.
OVERLEAF_MONGO_URL=mongodb://mongo-0.mongo.data-system.svc.cluster.local:27017/sharelatex?replicaSet=overleaf
OVERLEAF_REDIS_HOST=${dependency:overleaf-redis.host}
OVERLEAF_REDIS_PORT=${dependency:overleaf-redis.port}

# Every project file and history chunk, in Garage. The image prefixes the key id with GK.
OVERLEAF_S3_KEY_HEX=${secret:secret/data/overleaf-system/garage#s3.key_hex}
OVERLEAF_HISTORY_S3_SECRET_ACCESS_KEY=${secret:secret/data/overleaf-system/garage#s3.secret}
OVERLEAF_FILESTORE_S3_SECRET_ACCESS_KEY=${secret:secret/data/overleaf-system/garage#s3.secret}
OVERLEAF_HISTORY_BACKEND=s3
OVERLEAF_HISTORY_S3_ENDPOINT=http://garage.data-system.svc.cluster.local:3900
OVERLEAF_HISTORY_S3_PATH_STYLE=true
OVERLEAF_HISTORY_S3_REGION=garage
OVERLEAF_HISTORY_CHUNKS_BUCKET=overleaf-chunks
OVERLEAF_HISTORY_PROJECT_BLOBS_BUCKET=overleaf-project-blobs
OVERLEAF_HISTORY_BLOBS_BUCKET=overleaf-global-blobs
OVERLEAF_HISTORY_ZIPS_BUCKET=overleaf-zips
OVERLEAF_FILESTORE_BACKEND=s3
OVERLEAF_FILESTORE_S3_ENDPOINT=http://garage.data-system.svc.cluster.local:3900
OVERLEAF_FILESTORE_S3_PATH_STYLE=true
OVERLEAF_FILESTORE_S3_REGION=garage
OVERLEAF_FILESTORE_TEMPLATE_FILES_BUCKET_NAME=overleaf-template-files

# Password reset and invitation mail. 587 is STARTTLS submission, so not implicit TLS.
OVERLEAF_EMAIL_FROM_ADDRESS=latex@jorisjonkers.dev
OVERLEAF_EMAIL_SMTP_HOST=${dependency:stalwart.host}
OVERLEAF_EMAIL_SMTP_PORT=${dependency:stalwart.port}
OVERLEAF_EMAIL_SMTP_SECURE=false
OVERLEAF_EMAIL_SMTP_USER=latex@jorisjonkers.dev
OVERLEAF_EMAIL_SMTP_PASS=${secret:secret/data/platform/overleaf#smtp.password}
OVERLEAF_EMAIL_SMTP_TLS_REJECT_UNAUTH=false
